{
  "name": "p6-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tools/bundle.test.mjs",
    "publish:fixture": "node tools/publish.mjs",
    "publish:fixture:deploy": "node tools/publish.mjs --deploy",
    "publish:live": "node tools/publish.mjs --api http://127.0.0.1:8000",
    "publish:live:deploy": "node tools/publish.mjs --api http://127.0.0.1:8000 --deploy"
  },
  "dependencies": {
    "cesium": "^1.144.0",
    "maplibre-gl": "^5.24.0",
    "proj4": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright-core": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-cesium": "^1.2.23"
  }
